extends SceneTree
## Run once with "close", then in a fresh Godot process with "open".
## Checkpoint directories are generated by the recovery pilot during gameplay.
var host
var target={}
var phase=""
var ticks=0
var verified=false
var dir=""
func _initialize(): call_deferred("boot")
func boot():
	var args=OS.get_cmdline_user_args()
	if args.size()!=2 or args[1] not in ["close","open"]:
		quit(2)
		return
	dir=args[0]
	phase=args[1]
	target=JSON.parse_string(FileAccess.get_file_as_string(dir.path_join("expected.json")))
	host=load("res://game/Main.tscn").instantiate()
	host.prefs.path=dir.path_join("pilot-profile.cfg")
	root.add_child(host)
	if host.mode!="title" or host.items().is_empty() or host.items()[0][0]!="continue":
		printerr("No Continue item in isolated startup ",dir)
		quit(1)
		return
	physics_frame.connect(step)
func enter(pressed):
	var event=InputEventKey.new()
	event.keycode=KEY_ENTER
	event.physical_keycode=KEY_ENTER
	event.pressed=pressed
	Input.parse_input_event(event)
	Input.flush_buffered_events()
func state_matches():
	if host.arena.chapter!=int(target.chapter) or host.arena.section!=int(target.section): return false
	if host.prefs.score!=int(target.score) or host.prefs.difficulty!=int(target.difficulty): return false
	if host.prefs.records!=target.records or host.prefs.broadcast_pending!=bool(target.broadcast): return false
	match target.kind:
		"switchboard":
			var actual=host.board.checkpoint_state()
			if actual.rotations.size()!=target.saved.rotations.size(): return false
			for i in actual.rotations.size():
				if actual.rotations[i]!=int(target.saved.rotations[i]): return false
			for field in ["chapter","zone","cursor","moves"]:
				if int(actual[field])!=int(target.saved[field]): return false
		"traverse":
			if host.traverse.room!=int(target.saved.room) or host.traverse.target!=int(target.saved.target) or host.traverse.hp!=int(target.saved.hp): return false
		"memory":
			if host.arena.memoryrun.room!=int(target.saved.room) or host.arena.memoryrun.station!=int(target.saved.station): return false
		"broadcast":
			if not host.prefs.broadcast_pending or host.prefs.completed or host.items().size()!=2: return false
	return true

func step():
	ticks+=1
	if ticks==3: enter(true)
	elif ticks==4: enter(false)
	if not verified and host.mode==target.kind:
		if not state_matches():
			printerr("RESTORE MISMATCH ",target," after ",phase)
			quit(1)
			return
		verified=true
		print("RESTORE ",target.kind," ",phase," pid=",OS.get_process_id()," archive=",host.prefs.records.size()," score=",host.prefs.score)
		if phase=="close":
			# Use the same close notification as the native window close button.
			root.propagate_notification(Node.NOTIFICATION_WM_CLOSE_REQUEST)
		else:
			host.sound.silence()
			quit()
	if ticks>180:
		printerr("RESTORE TIMEOUT expected=",target.kind," got=",host.mode," phase=",phase)
		quit(1)
